# Generate a unique administrator token: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
CB_ADMIN_TOKEN=
# Optional Gmail OAuth client created in your own Google Cloud project.
CB_GOOGLE_CLIENT_ID=
CB_GOOGLE_CLIENT_SECRET=
# Example: http://localhost:8765/admin/oauth/google/callback
CB_GOOGLE_REDIRECT_URI=
# Exact HTTPS origin when serving the admin UI behind a TLS reverse proxy.
CB_PUBLIC_ORIGIN=
# Optional host loopback port for Compose; container port remains 8765.
CB_HOST_PORT=8765
